#!/bin/sh
# Set up a new agent checkout.
set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"

# Re-launch inside the flake's dev shell to load dependencies. This is safe to
# do even if a dev shell is already loaded, and it ensures we're running this
# checkout's shell. LAB_PREPARE_DEVSHELL limits this to a single recursion.
if [ -z "${LAB_PREPARE_DEVSHELL:-}" ]; then
    LAB_PREPARE_DEVSHELL=1 exec nix develop "$root" --command "$root/.agents/prepare" "$@"
fi

cd "$root/iac"
poetry install
poetry run labcli sync-imports
